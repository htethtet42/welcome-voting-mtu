# Supabase Postgres connection string.
#
# Supabase Dashboard → Project Settings → Database → Connection string → URI,
# and switch the mode to "Transaction pooler" (port 6543).
#
# Use the POOLER host (port 6543), not the direct connection (5432) — Supabase
# caps direct connections and a burst of voters will exhaust them.
#
# Note: if your password contains special characters (@ : / ? #) they must be
# percent-encoded in the URL.
DATABASE_URL=postgresql://postgres.odhhnawqwtrryjifgqij:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Port the Go server listens on. Defaults to 8081 when unset.
PORT=8081

# Same Google OAuth client ID as the frontend's VITE_GOOGLE_CLIENT_ID.
# The backend uses it as the expected audience when verifying ID tokens —
# without it, a token minted for any other site would be accepted.
GOOGLE_CLIENT_ID=
