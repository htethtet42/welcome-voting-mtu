# Base URL of the Go backend, including the /api suffix and no trailing slash.
#
# Local development (backend running via `cd backend && go run .`):
VITE_API_URL=http://localhost:8081/api
#
# Deployment: set this in Vercel → Project Settings → Environment Variables to
# your deployed backend's URL, then redeploy. Vite inlines the value at BUILD
# time, so changing it in Vercel requires a new deployment to take effect.

# Google OAuth client ID for voter sign-in.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). Add your frontend origins to "Authorized JavaScript
# origins" — e.g. http://localhost:5173 and your production URL.
VITE_GOOGLE_CLIENT_ID=
